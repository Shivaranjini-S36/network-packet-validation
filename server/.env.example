# Server Port Configuration
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# For local MongoDB: mongodb://127.0.0.1:27017/network_packet_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/network_packet_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/network_packet_db

# Database Name
DB_NAME=network_packet_db

# Environment Mode
NODE_ENV=development
